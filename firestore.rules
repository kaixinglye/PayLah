rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(profileId) {
      return signedIn() && request.auth.uid == profileId;
    }

    match /profiles/{profileId} {
      allow read, create, update, delete: if isOwner(profileId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.profileId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.profileId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if signedIn() && request.auth.uid == resource.data.adminId;
    }

    match /history/{tableId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid == request.resource.data.hostId;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if signedIn() && request.auth.uid == resource.data.hostId;
    }
  }
}
